# Definition for a binary tree node.
# class TreeNode(object):
#     def __init__(self, val=0, left=None, right=None):
#         self.val = val
#         self.left = left
#         self.right = right
class Solution(object):
    def isSymmetric(self, root):
        """
        :type root: Optional[TreeNode]
        :rtype: bool
        """
        left = []
        right = []
        left.append(root)
        right.append(root)
        same = True
        while len(left) != 0 and len(right) != 0:
            l = left.pop()
            r = right.pop()
            if (l is None and r is not None) or (l is not None and r is None) or (l is not None and r is not None and l.val != r.val):
                return False

            # to compare mirror we just have to append left and then right children to the left stack and in the opposite order for the right stack.
            if l is not None:
                left.append(l.left)
                left.append(l.right)
            if r is not None:
                right.append(r.right)
                right.append(r.left)
        return len(left) == len(right)# e.g.if one sub tree had more nodes than the other, then it is not symmetric.
