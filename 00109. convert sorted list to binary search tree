# create a BST class to easily complete problem
class BST():
    def __init__(self):
        self.root = None

    # function to add in a new node in the correct order
    def add(self, val):
        if (self.root is None):
            self.root = TreeNode(val)
        else:
            curr = self.root
            # traverse tree
            while (curr.left is not None and val < curr.val) or (curr.right is not None and val >= curr.val):
                if curr.val < val:
                    curr = curr.right
                else:
                    curr = curr.left
            # add in  new node
            if (curr.val > val):
                curr.left = TreeNode(val)
            else:
                curr.right = TreeNode(val)
    
    # function to get the root of the tree
    def getRoot(self):
        return self.root

            


# Array based solution.
class Solution(object):
    def sortedListToBST(self, head):
        """
        :type head: Optional[ListNode]
        :rtype: Optional[TreeNode]
        """
        array = self.convertToArray(head)
        tree = BST()
        self.appendValToTree(tree, 0, len(array) - 1, array)
        return tree.getRoot()




