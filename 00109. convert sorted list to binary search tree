    # recursive call to append the middle of the current list to the tree
    def appendValToTree(self, tree, start, end, array):
        if start > end:
            return
        else:
            mid = (start + end) // 2
            tree.add(array[mid])
            self.appendValToTree(tree, mid + 1, end, array)
            self.appendValToTree(tree, start, mid - 1, array)

    
        
