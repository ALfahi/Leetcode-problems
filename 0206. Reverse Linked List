# Definition for singly-linked list.
# class ListNode(object):
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution(object):
    def reverseList(self, head):
        """
        :type head: ListNode
        :rtype: ListNode
        """
        """
        :type head: ListNode
        :rtype: ListNode
        """
        if head is None:
            return head

        # edge case, we need to make head point to none
        ptr1 = head
        ptr2 = ptr1.next
        ptr1.next = None

        while (ptr1 is not None and ptr2 is not None):
            # simple loop, keep trackof next node, make ptr2's next point to prev node, move ptr1 to ptr2 
            # and move ptr2 to the next node, in the end ptr2 will reach end first, making ptr1
            #stop at the new head
            next = ptr2.next
            ptr2.next = ptr1
            ptr1 = ptr2
            ptr2 = next
        return ptr1
        # some sort of loop

            
        
        
