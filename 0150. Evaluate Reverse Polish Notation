class Solution(object):
    def evalRPN(self, tokens):
        """
        :type tokens: List[str]
        :rtype: int
        """
        stack = []
        def isInteger(char):
            try:
                int(char)
                print(char)
                return True
            except:
                return False
        def operate(num1, num2, operator):
            if operator == '+':
                return num1 + num2
            if operator == '-':
                return num1 - num2
            if operator == '*':
                return num1 * num2
            if operator == '/':
                result = abs(num1) // abs(num2)
                return -result if (num1 < 0) != (num2 < 0) else result
            
        for i in range(len(tokens)):
            if isInteger(tokens[i]):
                stack.append(int(tokens[i]))
            else:
                if len(stack) <= 1:# we need at least 2 numbers to perform operation
                    return False
                num2 = stack.pop()
                num1 = stack.pop()
                stack.append(operate(num1, num2, tokens[i]))
        return stack.pop()
