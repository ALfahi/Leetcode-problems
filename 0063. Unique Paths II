class Solution(object):
    def uniquePathsWithObstacles(self, obstacleGrid):
        """
        :type obstacleGrid: List[List[int]]
        :rtype: int
        """
        m, n = len(obstacleGrid), len(obstacleGrid[0])
        
        # start or end is blocked
        if obstacleGrid[0][0] == 1 or obstacleGrid[m - 1][n - 1] == 1:
            return 0
        
        return self.uniquePathAux(obstacleGrid, 0, 0, m, n, {})

    def uniquePathAux(self, obstacleGrid, i, j, m, n, memo):
        # reached destination
        if i == m - 1 and j == n - 1:
            return 1
        
        if (i, j) in memo:
            return memo[(i, j)]
        
        paths = 0
        
        # move down
        if i < m - 1 and obstacleGrid[i + 1][j] == 0:
            paths += self.uniquePathAux(obstacleGrid, i + 1, j, m, n, memo)
        
        # move right
        if j < n - 1 and obstacleGrid[i][j + 1] == 0:
            paths += self.uniquePathAux(obstacleGrid, i, j + 1, m, n, memo)
        
        memo[(i, j)] = paths
        return paths
