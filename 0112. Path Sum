# Definition for a binary tree node.
# class TreeNode(object):
#     def __init__(self, val=0, left=None, right=None):
#         self.val = val
#         self.left = left
#         self.right = right
class Solution(object):
    def hasPathSum(self, root, targetSum):
        """
        :type root: Optional[TreeNode]
        :type targetSum: int
        :rtype: bool
        """
        return self.hasPathSumAux(root, targetSum)
    
        
    def hasPathSumAux(self, node, targetSum):
        if node is None:
            return False
        targetSum -= node.val
        if node.left is None and node.right is None and targetSum == 0:
            return True
        left = self.hasPathSumAux(node.left, targetSum)
        right = self.hasPathSumAux(node.right, targetSum)
        return left or right
